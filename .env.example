# ========== SERVER CONFIG ==========
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ========== DATABASE ==========
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/elearning?retryWrites=true&w=majority
DB_NAME=elearning

# ========== JWT & SECURITY ==========
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production
REFRESH_TOKEN_EXPIRY=30d

# ========== ADMIN CREDENTIALS ==========
ADMIN_EMAIL=admin@elearning.com
ADMIN_PASSWORD=Admin@123456

# ========== GOOGLE OAUTH2 ==========
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ========== GOOGLE API CREDENTIALS ==========
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json
GOOGLE_TEMPLATE_DOC_ID=your_certificate_template_document_id
GOOGLE_DRIVE_FOLDER_ID=your_certificates_folder_id
GOOGLE_API_KEY=your_google_api_key

# ========== EMAIL CONFIGURATION ==========
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM_NAME=E-Learning Platform
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ========== PAYMENT GATEWAY (RAZORPAY) ==========
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ========== PAYMENT GATEWAY (STRIPE - OPTIONAL) ==========
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ========== FRONTEND URL ==========
FRONTEND_URL=http://localhost:3000
CLIENT_REDIRECT_URL=http://localhost:3000/dashboard

# ========== CERTIFICATE CONFIG ==========
CERTIFICATE_VALIDITY_DAYS=365
CERTIFICATE_ISSUER_NAME=E-Learning Platform
CERTIFICATE_SIGNATURE_URL=https://example.com/signature.png

# ========== FILE UPLOAD ==========
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,png

# ========== RATE LIMITING ==========
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========== CORS ==========
CORS_ORIGIN=http://localhost:3000

# ========== LOGGING ==========
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14
